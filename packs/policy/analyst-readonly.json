{
  "pack_id": "analyst-readonly",
  "schema_version": "v2",
  "version": "1.0.0",
  "compatibility": {
    "max_runtime_version": "0.x",
    "min_runtime_version": "0.1.0"
  },
  "defaults": {
    "abac_mode": "strict",
    "masking_enabled": true,
    "allow_write_operations": false,
    "ai_semantic_required": true
  },
  "roles": {
    "analyst": {
      "query": true,
      "retrieve": true,
      "policy_simulate": false
    }
  },
  "notes": "Conservative read-only policy template for analyst-heavy teams."
}

