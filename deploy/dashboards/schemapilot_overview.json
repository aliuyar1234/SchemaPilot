{
  "title": "SchemaPilot Overview",
  "timezone": "browser",
  "panels": [
    {
      "title": "Gateway Latency (ms)",
      "expr": "histogram_quantile(0.95, sum(rate(schemapilot_query_latency_ms_bucket[5m])) by (le))"
    },
    {
      "title": "Policy Denials",
      "expr": "sum(rate(schemapilot_policy_denials_total[5m]))"
    },
    {
      "title": "Review Queue Backlog",
      "expr": "sum(schemapilot_review_queue_backlog_total)"
    },
    {
      "title": "Contract Failures",
      "expr": "sum(rate(schemapilot_contract_failures_total[5m]))"
    },
    {
      "title": "Drift Events",
      "expr": "sum(rate(schemapilot_drift_events_total[5m]))"
    }
  ]
}
